BASE=~/.cache/huggingface/hub/models--unsloth--Qwen3.8-Flash-Next-GGUF
# BASE=~/.cache/huggingface/hub/models--unsloth--Qwen3.8-27B-GGUF
M="$BASE/snapshots/f5d175de2cf7f720d45d6064019a81fcf056e986/UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00004.gguf"
