#!/bin/zsh

local CWD="$PWD"
local TARGET="$1"
[ "$1" != "" ] && shift
if [ -d "$TARGET" ]; then
	TARGET="$(realpath $TARGET)"
	CWD="$TARGET"
elif [ -f "$TARGET" ]; then
	TARGET="$(realpath $TARGET)"
	CWD="$(dirname $TARGET)"
elif [ "$TARGET" != "" ]; then
	TARGET="$(realpath $TARGET)"
	touch "$TARGET"
	CWD="$(dirname $TARGET)"
fi

export ZDOTDIR=~/.dotfiles

local CMD=()

[ "$(which kitty)" != "" ] && [ "$WAYLAND_DISPLAY" != "" ] && CMD+=(kitty -d $TARGET --)

[[ -e /usr/bin/bwrap ]] && CMD+=(env TARGET=$TARGET bwrapper)

CMD+=(nvim "$TARGET" $@)

echo $CMD

pushd $CWD

if [[ "$CMD" = *"kitty"* ]]; then
	$CMD &>/dev/null &
else
	$CMD
fi

popd
