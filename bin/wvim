#!/bin/zsh

local CWD="$PWD"
local TARGET="$1"
[ "$1" != "" ] && shift
if [ -d "$TARGET" ]; then
	TARGET="$(realpath $TARGET)"
	CWD="$TARGET"
elif [ -f "$TARGET" ]; then
	TARGET="$(realpath $TARGET)"
	CWD="$(dirname $TARGET)"
elif [ "$TARGET" != "" ]; then
	TARGET="$(realpath $TARGET)"
	touch "$TARGET"
	CWD="$(dirname $TARGET)"
fi

local -a CMD=()

[[ "$(which kitty)" != "" && -n "$WAYLAND_DISPLAY" ]] && CMD+=(kitty -d $TARGET --)

if [[ -e /usr/bin/bwrap ]]; then
	local -a RO_PATHS=(
		"${RO_PATHS[@]}"

		".local/share/nvim"
		".config/nvim"
		".config/github-copilot"
	)

	local -a RW_PATHS=(
		"${RW_PATHS[@]}"

		".local/state/nvim"
		".cache/nvim"
		".cache/biome"
	)

	if [[ "$TARGET" -ef "$HOME/.dotfiles" ]]; then
		RW_PATHS+=(".local/share/nvim")
	fi

	CMD+=(env TARGET="$TARGET" RW_PATHS="${(j:,:)RW_PATHS}" RO_PATHS="${(j:,:)RO_PATHS}" bwrapper)
fi

CMD+=(nvim "$TARGET" $@)

pushd $CWD

if [[ "$CMD" = *"kitty"* ]]; then
	exec $CMD &>/dev/null &
else
	exec $CMD
fi

popd
