#!/bin/zsh

local CWD="$PWD"
local TARGET="$1"
[ "$1" != "" ] && shift
if [ -d "$TARGET" ]; then
	TARGET="$(realpath $TARGET)"
	CWD="$TARGET"
elif [ -f "$TARGET" ]; then
	TARGET="$(realpath $TARGET)"
	CWD="$(dirname $TARGET)"
elif [ "$TARGET" != "" ]; then
	TARGET="$(realpath $TARGET)"
	touch "$TARGET"
	CWD="$(dirname $TARGET)"
fi

local -a CMD=()

[ "$(which kitty)" != "" ] && [ "$WAYLAND_DISPLAY" != "" ] && CMD+=(kitty -d $TARGET --)

if [[ -e /usr/bin/bwrap ]]; then
	local RO_PATHS="$HOME/.local/share/nvim"
	local RW_PATHS="$HOME/.local/state/nvim:$HOME/.cache/nvim:$HOME/.cache/biome"
	if [[ "$TARGET" -ef "$HOME/.dotfiles" ]]; then
		RW_PATHS="$HOME/.local/share/nvim:$RW_PATHS"
		RO_PATHS=""
	fi

	CMD+=(env TARGET=$TARGET RW_PATHS="$RW_PATHS" RO_PATHS="$RO_PATHS" bwrapper)
fi

CMD+=(nvim "$TARGET" $@)

pushd $CWD

if [[ "$CMD" = *"kitty"* ]]; then
	$CMD &>/dev/null &
else
	$CMD
fi

popd
