#!/bin/zsh

local CWD="$PWD"
local TARGET="$1"
[[ -n "$1" ]] && shift
if [[ -d "$TARGET" ]]; then
	TARGET="$(realpath $TARGET)"
	CWD="$TARGET"
elif [[ -f "$TARGET" ]]; then
	TARGET="$(realpath $TARGET)"
	CWD="$(dirname $TARGET)"
elif [[ "$TARGET" != "" ]]; then
	TARGET="$(realpath $TARGET)"
	touch "$TARGET"
	CWD="$(dirname $TARGET)"
fi

local -a CMD=()

[[ -n "$(command -v kitty 2>/dev/null)" && -n "$WAYLAND_DISPLAY" ]] && CMD+=(kitty -d $TARGET --)

if [[ -e /usr/bin/bwrap ]]; then
	local -a RO_PATHS=(
		"${RO_PATHS[@]}"

		".local/share/nvim"
		".config/nvim"
		".config/github-copilot"

		".local/share/nvim/mason/bin/"
	)

	local -a RW_PATHS=(
		"${RW_PATHS[@]}"

		".local/state/nvim"
		".cache/nvim"
		".cache/biome"
	)

	if [[ "$TARGET" -ef "$HOME/.dotfiles" ]]; then
		RW_PATHS+=(".local/share/nvim")
	fi
	PATH="$PATH:$HOME/.local/share/nvim/mason/bin/"
	CMD+=(env TARGET="$TARGET" RW_PATHS="${(j:,:)RW_PATHS}" RO_PATHS="${(j:,:)RO_PATHS}" bwrapper)
fi

CMD+=(nvim "$TARGET" $@)

pushd $CWD

if [[ "$CMD" = *"kitty"* ]]; then
	"${CMD[@]}" &>/dev/null &
else
	"${CMD[@]}"
fi

popd
