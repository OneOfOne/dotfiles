#!/bin/zsh

set -euo pipefail

typeset -ga CMD=(
	bwrap
	--unshare-all --share-net --new-session --die-with-parent
	--dev /dev --proc /proc
	--tmpfs /tmp --tmpfs /run --tmpfs /dev/shm

	--dev-bind-try /dev/dri /dev/dri
	--dev-bind-try /dev/tty /dev/tty

	--uid $UID --gid $GID

	--clearenv
)

# Associative array: keys are the paths that have already been bound.
typeset -gA BOUND=()

add_env() {
	local name value
	if (($# == 1)); then
		[[ "$1" == *=* ]] || {
			echo "add_env: expected NAME=VALUE" >/dev/stderr
			return 1
		}
		name="${1%%=*}"
		value="${1#*=}"
	else
		name="$1"
		value="$2"
	fi

	[[ -n $value ]] || return 0

	CMD+=(--setenv "$name" "$value")
}

add_bind() {
	local src="$1"
	local dst="${2:-$1}"
	[[ -n "$dst" ]] || return 0

	[[ "$src" != /* ]] && src="$HOME/$src"
	[[ "$dst" != /* ]] && dst="$HOME/$dst"

	local bind_type="--ro-bind"
	[[ -n "${RW:-}" ]] && bind_type="--bind"

	[[ "${BOUND[$src]:-}" == "$bind_type" ]] && return

	if [[ -L "$src" ]]; then
		local target="${src:P}"

		if [[ "$target" != "$dst" && -z "${BOUND[$target]:-}" ]]; then
			CMD+=("$bind_type" "$target" "$target")
			BOUND[$target]=$bind_type
		fi

		if [[ -e "$target" && -L "$dst" ]]; then
			CMD+=(--symlink "${target}" "${dst}")
		fi
	elif [[ -e "$src" ]]; then
		CMD+=("$bind_type" "$src" "$dst")
	else
		echo "bind: $src doesn't exist" >/dev/stderr
	fi

	BOUND[$src]=$bind_type
}

add_blocked_path() {
	local p=$1

	[[ "$p" != /* ]] && p="$HOME/$p"

	if [[ -d "$p" ]]; then
		CMD+=(--tmpfs "$p")
	else
		CMD+=(--ro-bind /dev/null "$p")
	fi
}

add_xdg() {
	[[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" ]] || return 0
	local XDG="$XDG_RUNTIME_DIR"

	add_env XDG_RUNTIME_DIR "$XDG"
	CMD+=(--perms 0700 --dir "$XDG")

	if [[ -n "${DISPLAY:-}" ]]; then
		add_env DISPLAY "$DISPLAY"
		if [[ $DISPLAY == :* || $DISPLAY == unix:* ]]; then
			local xnum=${DISPLAY#*:}
			xnum=${xnum%%.*}
			add_bind "/tmp/.X11-unix/X$xnum"
		fi

		# Auth cookie: $XAUTHORITY if set, else ~/.Xauthority.
		local xauth=${XAUTHORITY:-$HOME/.Xauthority}
		if [[ -e $xauth ]]; then
			add_env XAUTHORITY "$xauth"
			add_bind "$xauth"
		fi
	fi

	# Wayland + D-Bus
	if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
		add_env WAYLAND_DISPLAY "$WAYLAND_DISPLAY"
		add_env "DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG/bus"
		add_bind "$XDG/$WAYLAND_DISPLAY"
		add_bind "$XDG/bus"
	fi

	# PipeWire (native protocol; the manager socket is optional)
	add_bind "$XDG/pipewire-0"
	add_bind "$XDG/pipewire-0-manager"

	if [[ -S "$XDG/pulse/native" ]]; then
		add_env PULSE_SERVER "unix:$XDG/pulse/native"
		add_bind "$XDG/pulse/native"
	fi

	# needed for xdg-open / kde-open
	add_env XDG_CURRENT_DESKTOP "${XDG_CURRENT_DESKTOP:-}"
	add_env KDE_SESSION_VERSION "${KDE_SESSION_VERSION:-}"
	add_bind ".local/share/applications"

	RW=1 add_bind ".cache/mesa_shader_cache"
	RW=1 add_bind ".cache/radv_builtin_shaders"
	add_bind ".local/share/vulkan"

	if [[ -d "$HOME/.cache/lsfg-vk" && -d "$HOME/.config/lsfg-vk" ]]; then
		RW=1 add_bind ".cache/lsfg-vk"
		add_bind ".config/lsfg-vk"
	fi
}

main() {
	local TARGET="${TARGET:-$PWD}"
	local value

	if [[ "$TARGET" == "$HOME" && "${ALLOW_HOME:-}" != "1" ]]; then
		echo "RW access to home isn't allowed, use ALLOW_HOME=1" >/dev/stderr
		exit 1
	fi

	# System directories (read-only by default).
	for value in /usr /bin /sbin /lib /lib64 /var /sys /opt/google /opt/rocm; do
		add_bind "$value"
	done

	local -a ENV_VARS=(
		"HOME=$HOME"
		"USER=$USER"
		"LOGNAME=$USER"
		"PATH=$PATH"
		"SHELL=${SHELL:-/bin/zsh}"
		"EDITOR=${EDITOR:-}"
		"GIT_EDITOR=${GIT_EDITOR:-}"
		"COLORTERM=${COLORTERM:-}"
		"TERM=${TERM:-xterm-256color}"
		"TMPDIR=/tmp"
		"PWD=$TARGET"

		"LANG=${LANG:-}"

		${(s.:.)ENV:-}
	)

	for value in "${ENV_VARS[@]}"; do
		add_env "$value"
	done

	local -a BLOCKED_PATHS_VARS=(
		${(s.:.)${BLOCKED_PATHS:-}}

		".cache"
		".config"
	)

	local -a RO_PATHS_VARS=(
		${(s.:.)${RO_PATHS:-}}
		# ${(s.:.)${PATH:-}}

		"/run/systemd/resolve"
		"/etc/resolv.conf"

		"/etc/ld.so.cache"
		"/etc/ld.so.conf"
		"/etc/ld.so.conf.d"

		"/etc/fonts"

		"/etc/passwd"
		"/etc/group"

		"/etc/hosts"
		"/etc/nsswitch.conf"
		"/etc/localtime"

		"/etc/ssl"
		"/etc/ca-certificates"

		".config/kitty"
		".config/fontconfig"
		".local/share/fonts"

		".rustup"
		".cargo"

		".dotfiles"
		".gitconfig"
		".zshrc"

		".ssh/github_known_hosts"
		".ssh/github"
		".ssh/github.pub"

		"Pictures/nyc.jpg"
	)
	[[ -e "$HOME/.ssh/github_config" ]] && add_bind ".ssh/github_config" ".ssh/config"

	local -a RW_PATHS_VARS=(
		"$TARGET"
		${(s.:.)${RW_PATHS:-}}

		".cache/zsh"
		".cache/oh-my-zsh"
		".cache/p10k-$USER"
		".cache/gitstatus"

		".cache/pkg"

		".cache/kitty"
		".cache/fontconfig"

		".config/lazygit"
		".local/state/lazygit"

		".tmux"
		".omp"
		".bun"
		".gradle"
		".gnupg"

		".config/kde-openrc"
		".config/pinentry-qtrc"
	)

	if ((${+commands[go]})); then
		RW_PATHS+=("$(go env GOMODCACHE 2>/dev/null)" "go")
		RO_PATHS+=("code/go/bin")
	fi

	for value in "${BLOCKED_PATHS_VARS[@]}"; do
		add_blocked_path "$value"
	done

	add_xdg

	for value in "${RO_PATHS_VARS[@]}"; do
		add_bind "$value"
	done

	for value in "${RW_PATHS_VARS[@]}"; do
		RW=1 add_bind "$value"
	done

	CMD+=(--remount-ro / --chdir "$TARGET")

	exec "${CMD[@]}" "$@"
}

main "$@"
