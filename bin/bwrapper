#!/bin/zsh

set -euo pipefail

typeset -ga CMD=(
	bwrap
	--unshare-all --share-net --new-session --die-with-parent
	--dev /dev --proc /proc
	--tmpfs /tmp --tmpfs /run --tmpfs /dev/shm

	--dev-bind-try /dev/dri /dev/dri
	--dev-bind-try /dev/tty /dev/tty

	--uid "$(id -u)" --gid "$(id -g)"

	--clearenv
)

add_env() {
	local parts=("${(s:=:)1}")
	local name="${parts[1]}"
	local value="${parts[2]:-${2:-}}"

	[[ -n $value ]] || return 0

	CMD+=(--setenv "$name" "$value")
}

add_bind() {
	local src="$1"
	local dst="${2:-$1}"
	[[ -n "$dst" ]] || return 0

	[[ "$src" != /* ]] && src="$HOME/$src"
	[[ "$dst" != /* ]] && dst="$HOME/$dst"

	local bind_type="--ro-bind"
	[[ -n "${RW:-}" ]] && bind_type="--bind"

	if [[ -L "$src" ]]; then
		local target="$(readlink "$src")" || return 0
		local dir="${src:h}"
		[[ $target != /* ]] && target="${dir%/}/$target"

		if [[ "$target" != "$dst" ]]; then
			CMD+=("$bind_type" "$target" "$target")
		fi

		if [[ -e "$target" && -L "$dst" ]]; then
			CMD+=(--symlink "${target}" "${dst}")
		fi
	elif [[ -e "$src" ]]; then
		CMD+=("$bind_type" "$src" "$dst")
	fi
}

add_blocked_path() {
	local p=$1

	if [[ -d "$p" ]]; then
		CMD+=(--tmpfs "$p")
	else
		CMD+=(--ro-bind /dev/null "$p")
	fi
}

main() {
	local TARGET="${TARGET:-$PWD}"
	local value

	if [[ "$TARGET" == "$HOME" && "${ALLOW_HOME:-}" != "1" ]]; then
		echo "RW access to home isn't allowed, use ALLOW_HOME=1" >/dev/stderr
		exit 1
	fi

	# System directories (read-only by default).
	for value in /usr /bin /sbin /lib /lib64 /var /sys /opt/google /opt/rocm; do
		add_bind "$value"
	done

	# Wayland / D-Bus (conditional)
	if [[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" ]]; then
		add_env XDG_RUNTIME_DIR "$XDG_RUNTIME_DIR"
		# Created before any mounts, with the permissions clients expect.
		CMD+=(--perms 0700 --dir "$XDG_RUNTIME_DIR")

		# Wayland + D-Bus
		if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
			add_env WAYLAND_DISPLAY "$WAYLAND_DISPLAY"
			add_env DBUS_SESSION_BUS_ADDRESS "unix:path=$XDG_RUNTIME_DIR/bus"
			add_bind "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
			add_bind "$XDG_RUNTIME_DIR/bus"
		fi

		# PipeWire (native protocol; the manager socket is optional)
		add_bind "$XDG_RUNTIME_DIR/pipewire-0"
		add_bind "$XDG_RUNTIME_DIR/pipewire-0-manager"

		if [[ -S "$XDG_RUNTIME_DIR/pulse/native" ]]; then
			add_env PULSE_SERVER "unix:$XDG_RUNTIME_DIR/pulse/native"
			add_bind "$XDG_RUNTIME_DIR/pulse/native"
		fi

		add_bind ".local/share/vulkan"
		RW=1 add_bind ".cache/mesa_shader_cache"
		RW=1 add_bind ".cache/radv_builtin_shaders"

		RW=1 add_bind ".cache/lsfg-vk"
		add_bind ".config/lsfg-vk"
	fi

	if [[ -n "${DISPLAY:-}" ]]; then
		add_env DISPLAY "$DISPLAY"
		if [[ $DISPLAY == :* || $DISPLAY == unix:* ]]; then
			local xnum=${DISPLAY#*:}
			xnum=${xnum%%.*}
			add_bind "/tmp/.X11-unix/X$xnum"
		fi

		# Auth cookie: $XAUTHORITY if set, else ~/.Xauthority.
		local xauth=${XAUTHORITY:-$HOME/.Xauthority}
		if [[ -e $xauth ]]; then
			add_env XAUTHORITY "$xauth"
			add_bind "$xauth"
		fi
	fi

	local -a ENV=(
		"HOME=$HOME"
		"USER=$USER"
		"LOGNAME=$USER"
		"PATH=$PATH"
		"SHELL=${SHELL:-/bin/zsh}"
		"EDITOR=${EDITOR:-}"
		"COLORTERM=${COLORTERM:-}"
		"TERM=${TERM:-xterm-256color}"
		"ANDROID_HOME=${ANDROID_HOME:-}"
		"TMPDIR=/tmp"
		"PWD=$TARGET"

		"${(s.,.)${ENV:-}[@]}"
	)

	for value in "${ENV[@]}"; do
		add_env "$value"
	done

	local -a BLOCKED_PATHS=()
	for value in "${BLOCKED_PATHS[@]}"; do
		add_blocked_path "$value"
	done

	local -a RO_PATHS=(
		"${(s.,.)${RO_PATHS:-}[@]}"

		"/run/systemd/resolve"
		"/etc/resolv.conf"

		"/etc/ld.so.cache"
		"/etc/ld.so.conf"
		"/etc/ld.so.conf.d"

		"/etc/fonts"

		"/etc/passwd"
		"/etc/group"

		"/etc/hosts"
		"/etc/nsswitch.conf"
		"/etc/localtime"

		"/etc/ssl/"
		"/etc/ca-certificates"

		".config/kitty"
		".config/fontconfig"
		".local/share/fonts"

		".rustup"
		".cargo"

		".dotfiles"
		".gitconfig"
		".zshrc"

		".ssh/github_known_hosts"
		".ssh/github"
		".ssh/github.pub"

		"Pictures/nyc.jpg"
	)

	for value in "${RO_PATHS[@]}"; do
		add_bind "$value"
	done
	add_bind ".ssh/github_config" ".ssh/config"

	local -a RW_PATHS=(
		"$TARGET"
		"${(s.,.)${RW_PATHS:-}[@]}"

		".cache/zsh"
		".cache/oh-my-zsh"
		".cache/p10k-$USER"
		".cache/gitstatus"

		"$(go env GOMODCACHE 2>/dev/null)"

		".cache/pkg"

		".cache/kitty"
		".cache/fontconfig"

		".config/lazygit"
		".local/state/lazygit"

		".tmux"
		".omp"
		".bun"
		".gradle"
		".gnupg"

		".config/kde-openrc"
		".config/pinvalue-qtrc"
	)

	for value in "${RW_PATHS[@]}"; do
		RW=1 add_bind "$value"
	done

	CMD+=(--remount-ro / --chdir "$TARGET")

	exec "${CMD[@]}" "$@"
}

main "$@"
