#!/bin/zsh

set -euo pipefail

main() {
	local -a CMD=()
	# Init from the inherited colon-separated env vars; a bare `local -a X=()` discards them.
	local -a RW_PATHS=(${(s.:.)${RW_PATHS:-}})
	local -a RO_PATHS=(${(s.:.)${RO_PATHS:-}})
	local -a JAIL_BLOCKED=()
	local -a JAIL_RO=()
	local -a JAIL_RW=()
	local TARGET="${TARGET:-$PWD}"

	CMD=(
		bwrap
		--unshare-all --share-net --new-session --die-with-parent
		--dev /dev --proc /proc
		--tmpfs /tmp --tmpfs /run --tmpfs /dev/shm

		--dev-bind-try /dev/dri /dev/dri

		--clearenv
		--setenv SHELL "$SHELL" --setenv EDITOR "$EDITOR"
		--setenv PATH "$PATH" --setenv HOME "$HOME"
		--setenv COLORTERM "$COLORTERM" --setenv TERM "$TERM"
		--setenv ANDROID_HOME "$ANDROID_HOME"
	)

	if [[ "$TARGET" -ef "$HOME" ]]; then
		mkdir -p /tmp/home-$USER
		TARGET=/tmp/home-$USER
	fi

	for dir in "$HOME" /usr /bin /sbin /lib /lib64 /var /sys; do
		CMD+=(--ro-bind "$dir" "$dir")
	done

	if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
		local runtime="$XDG_RUNTIME_DIR"
		CMD+=(
			--setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY"
			--setenv XDG_RUNTIME_DIR "$runtime"
			--setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$runtime/bus"
			--ro-bind-try "$runtime/$WAYLAND_DISPLAY" "$runtime/$WAYLAND_DISPLAY"
			--ro-bind-try "$runtime/bus" "$runtime/bus"
		)
	fi

	JAIL_BLOCKED+=(
		"$HOME/.ssh"
		"$HOME/.cache"

		"$HOME/.config/google-chrome"
		"$HOME/.config/gcloud"
		"$HOME/.config/github-copilot"

		"$HOME/.rustup"
		"$HOME/.cargo"
		"$HOME/.docker"
		# "$HOME/.gnupg"
		"$HOME/.expo"
		"$HOME/.app-store"

		"$HOME/passwords.kdbx"

		"$HOME/.npmrc"
		"$HOME/.git-credentials"
		"$HOME/.gitcookies"

		"$HOME/.local/share/keyrings"
		"$HOME/.psql_history"
		"$HOME/.mysql_history"

		"$HOME/.python_history"
		"$HOME/.node_repl_history"

		"$HOME/Downloads"
	)

	for v in "${JAIL_BLOCKED[@]}"; do
		[[ -d "$v" ]] && CMD+=(--tmpfs "${v:A}")
		[[ -f "$v" ]] && CMD+=(--ro-bind /dev/null "${v:A}")
	done

	JAIL_RO+=(
		"${RO_PATHS[@]}"

		"/run/systemd/resolve"
		"/etc/passwd"
		"/etc/group"

		"/etc/hosts"

		"/etc/nsswitch.conf"
		"/etc/localtime"

		"/etc/ssl/"
		"/etc/ca-certificates"

		# github stuff
		"$HOME/.ssh/github_known_hosts"
		"$HOME/.ssh/github"
		"$HOME/.ssh/github.pub"
	)

	for v in "${JAIL_RO[@]}"; do
		CMD+=(--ro-bind "${v:A}" "${v:A}")
	done

	CMD+=(--ro-bind "$HOME/.ssh/github_config" "$HOME/.ssh/config")
	CMD+=(--symlink "/run/systemd/resolve/resolv.conf" "/etc/resolv.conf")

	JAIL_RW+=(
		"$TARGET"
		"${RW_PATHS[@]}"

		"$HOME/.cache/go-build"
		"$HOME/go/pkg"

		"$HOME/.cache/zsh"
		"$HOME/.cache/oh-my-zsh"
		"$HOME/.cache/gitstatus"

		"$HOME/.cache/fontconfig"

		"$HOME/.local/state/nvim"

		"$HOME/.omp"
		"$HOME/.dotfiles/.omp"

		"$HOME/.bun"
		"$HOME/.gradle"

		# needed for git
		"$HOME/.gnupg"

		"$HOME/.config/kde-openrc"
		"$HOME/.config/pinentry-qtrc"
	)

	if command -v go >/dev/null; then
		JAIL_RW+=("$(go env GOMODCACHE)")
	fi

	if [[ -d "$HOME/.config/lazygit" ]]; then
		JAIL_RW+=("$HOME/.config/lazygit" "$HOME/.local/state/lazygit")
	fi

	if [[ "$TARGET" -ef "$HOME/.dotfiles" ]]; then
		JAIL_RW+=("$HOME/.local/share/nvim")
	fi

	for v in "${JAIL_RW[@]}"; do
		CMD+=(--bind "${v:A}" "${v:A}")
	done

	CMD+=(--chdir "$TARGET")

	# echo $CMD
	exec "${CMD[@]}" "$@"
}

main "$@"
