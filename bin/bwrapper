#!/bin/zsh

set -euo pipefail

main() {
	local -a CMD=()
	local -a RW_PATHS=()
	local -a JAIL_RW=()
	local -a JAIL_BLOCKED=()
	local TARGET="${TARGET:-$PWD}"

	# Do not use top-level local.
	CMD=(
		bwrap
		--unshare-all --share-net --new-session --die-with-parent
		--dev /dev --proc /proc --tmpfs /tmp --tmpfs /run --tmpfs /dev/shm
		--dev-bind-try /dev/dri /dev/dri
		--ro-bind /sys /sys
	)

	for dir in "$HOME" /usr /bin /sbin /lib /lib64 /var; do
		CMD+=(--ro-bind "$dir" "$dir")
	done

	if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
		local runtime="$XDG_RUNTIME_DIR"
		CMD+=(
			--setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY"
			--setenv XDG_RUNTIME_DIR "$runtime"
			--setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$runtime/bus"
			--ro-bind-try "$runtime/$WAYLAND_DISPLAY" "$runtime/$WAYLAND_DISPLAY"
			--ro-bind-try "$runtime/bus" "$runtime/bus"
		)
	fi

	CMD+=(
		--ro-bind /etc/resolv.conf /etc/resolv.conf
		--ro-bind /run/systemd/resolve /run/systemd/resolve

		--ro-bind-try /etc/hosts /etc/hosts

		--ro-bind /etc/nsswitch.conf /etc/nsswitch.conf
		--ro-bind /etc/localtime /etc/localtime

		--ro-bind /etc/ssl/ /etc/ssl/
		--ro-bind /etc/ca-certificates /etc/ca-certificates
	)

	JAIL_BLOCKED+=(
		"$HOME/.ssh"
		"$HOME/.cache"

		# "$HOME/.config/google-chrome"
		# "$HOME/.cache/google-chrome"

		"$HOME/.config/gcloud"
		"$HOME/.config/github-copilot"

		"$HOME/.rustup"
		"$HOME/.cargo"
		"$HOME/.docker"
		"$HOME/.gnupg"
		"$HOME/.expo"
		"$HOME/.app-store"

		"$HOME/passwords.kdbx"

		"$HOME/.npmrc"
		"$HOME/.git-credentials"
		"$HOME/.gitcookies"

		"$HOME/.local/share/keyrings"
		"$HOME/.psql_history"
		"$HOME/.mysql_history"

		"$HOME/.python_history"
		"$HOME/.node_repl_history"

		"$HOME/Downloads"
	)

	for v in "${JAIL_BLOCKED[@]}"; do
		[[ -d "$v" ]] && CMD+=(--tmpfs "${v:A}")
		[[ -f "$v" ]] && CMD+=(--ro-bind /dev/null "${v:A}")
	done

	# Use a safer delimiter for RW_PATHS.
	[[ -n "${RW_PATHS:-}" ]] && RW_PATHS=(${(s.:.)RW_PATHS})

	JAIL_RW+=("$TARGET")
	JAIL_RW+=("${RW_PATHS[@]}")
	JAIL_RW+=(
		"$TARGET"
		"${RW_PATHS[@]}"

		"$HOME/.cache/go-build"
		"$HOME/.cache/zsh"

		"$HOME/.local/state/nvim"
		"$HOME/.local/share/nvim"
		"$HOME/.dotfiles/.config/nvim"

		"$HOME/.omp"
		"$HOME/.dotfiles/.omp"

		"$HOME/.bun"

		"$HOME/.config/kde-openrc"
		"$HOME/.config/pinentry-qtrc"
	)

	if command -v go >/dev/null; then
		local GOMODCACHE
		GOMODCACHE="$(go env GOMODCACHE)"
		JAIL_RW+=("$GOMODCACHE")
	fi

	if [[ -d "$HOME/.config/lazygit" ]]; then
		JAIL_RW+=("$HOME/.config/lazygit" "$HOME/.local/state/lazygit")
	fi

	for v in "${JAIL_RW[@]}"; do
		local -a p=("${v:A}") # canonical path, builtin (no fork)
		CMD+=(--bind "${p[1]}" "${p[1]}")
	done

	CMD+=(--chdir "$TARGET")

	echo $CMD
	exec "${CMD[@]}" "$@"
}

main "$@"
